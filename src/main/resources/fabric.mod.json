{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description} ${mod_credits}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "golemcore:entry": [
            "com.ntmspace.SpaceEntry"
        ],
        "client": [
            "com.ntmspace.platform.fabric.FabricClientInit"
        ],
        "jei_mod_plugin": [
            "com.ntmspace.jei.SpaceJeiPluginFabric"
        ],
        "fabric-gametest": [
            "com.ntmspace.platform.fabric.FabricGameTests"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "fabric-api": "*",
        "golemcore": "*",
        "hbm": "*",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    }
}
